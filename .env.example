# Copy to .env and fill in local values. Do not commit secrets.

# Required
GEMINI_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/modiseh

# Agent / Gemini
AGENT_MODEL=gemini-2.5-flash
AGENT_THINKING_BUDGET=0
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRY_ATTEMPTS=2

# Product Search (defaults are production-safe; do not enable rerank/embeddings/name matching)
LLM_METADATA_FALLBACK_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.7
LLM_RERANK_ENABLED=false
LLM_QUERY_UNDERSTANDING_ENABLED=false
PRODUCT_NAME_MATCHING_ENABLED=false
LLM_TIMEOUT_SECONDS=20

# API
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_BODY_BYTES=16384
CONVERSATION_HISTORY_LIMIT=8
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501,http://127.0.0.1:8000,http://127.0.0.1:8501

# Database
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=INFO
# LOG_RAW_QUERIES=false
